# ===========================================
# MAILIX — Environment Configuration Example
# Copy to .env and fill in real values
# Never commit .env to version control
# ===========================================

# Server
MAILIX_PORT=7345
MAILIX_ENV=development
# Options: development, test, production
MAILIX_BASE_URL=http://localhost:7345

# Database
# Options: json (default for local/demo), postgres (for production)
MAILIX_DB_TYPE=json
MAILIX_DATABASE_URL=postgres://user:pass@localhost:5432/mailix

# Data directory (optional — defaults to ./data relative to project root)
# MAILIX_DATA_DIR=/path/to/data

# Redis (for queue, optional — falls back to in-memory if not set)
# MAILIX_REDIS_URL=redis://localhost:6379

# ===========================================
# Email Provider
# ===========================================
# Options: local, smtp, ses, resend
#
# local — simulated delivery only (no real emails sent, captured in local inbox)
#          This is the safe default for development and testing.
#
# smtp/ses/resend — real delivery. Requires corresponding credentials below.
#
MAILIX_EMAIL_PROVIDER=local

# SMTP Settings (used when MAILIX_EMAIL_PROVIDER=smtp)
MAILIX_SMTP_HOST=
MAILIX_SMTP_PORT=587
MAILIX_SMTP_SECURE=false
MAILIX_SMTP_USER=
MAILIX_SMTP_PASSWORD=
MAILIX_SMTP_FROM=hello@yourdomain.com

# Amazon SES (used when MAILIX_EMAIL_PROVIDER=ses)
MAILIX_SES_REGION=us-east-1
MAILIX_SES_ACCESS_KEY=
MAILIX_SES_SECRET_KEY=
MAILIX_SES_FROM=hello@yourdomain.com

# Resend (used when MAILIX_EMAIL_PROVIDER=resend)
MAILIX_RESEND_API_KEY=
MAILIX_RESEND_FROM=hello@yourdomain.com

# Webhook secret for Resend delivery events (required in production with resend provider)
MAILIX_RESEND_WEBHOOK_SECRET=

# ===========================================
# Security
# ===========================================
# REQUIRED in production: change to a long, random string (32+ chars)
MAILIX_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated list of allowed origins (no wildcards in production)
MAILIX_ALLOWED_ORIGINS=http://localhost:7345,http://127.0.0.1:7345

# Rate limiting
MAILIX_RATE_LIMIT_WINDOW_MS=60000
MAILIX_RATE_LIMIT_MAX=100

# Trust reverse proxy headers (set to true when behind nginx/cloudflare/etc)
MAILIX_TRUST_PROXY=false

# ===========================================
# Logging
# ===========================================
# Options: error, warn, info, debug
MAILIX_LOG_LEVEL=info
