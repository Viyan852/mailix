    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.7",
    "uuid": "^9.0.0"
  },
  "optionalDependencies": {
    "aws-sdk": "^2.1466.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "rcedit": "^5.0.2"
  }
